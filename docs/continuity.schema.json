{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datascape.local/schemas/continuity.schema.json",
  "title": "Datascape Continuity data",
  "type": "object",
  "required": ["snapshots"],
  "properties": {
    "_readme": { "type": "string" },
    "attentionBudget": {
      "type": "object",
      "properties": {
        "maxNeighbors": { "type": "integer", "minimum": 1, "maximum": 4 },
        "targetReadSeconds": { "type": "integer", "minimum": 5, "maximum": 60 }
      },
      "additionalProperties": true
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/snapshot" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["id", "label", "largeContext", "dominant", "concepts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "largeContext": { "type": "string", "minLength": 1 },
        "dominant": { "type": "string", "minLength": 1 },
        "hiddenCount": { "type": "integer", "minimum": 0 },
        "concepts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/concept" }
        }
      },
      "additionalProperties": true
    },
    "concept": {
      "type": "object",
      "required": ["status", "summary", "resolutions"],
      "properties": {
        "parent": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "live",
            "committed",
            "merged",
            "superseded",
            "deferred",
            "reverted",
            "blocked",
            "needs_human"
          ]
        },
        "summary": { "type": "string", "minLength": 1 },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    }
  }
}
